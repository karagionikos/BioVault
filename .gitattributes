# Line endings: LF in the repository and in every checkout, Windows included (D82).
# rustfmt, Prettier and .editorconfig all write LF, and Android builds run Unix scripts.
* text=auto eol=lf

# Scripts that must keep one line ending wherever they're checked out
*.sh      text eol=lf
gradlew   text eol=lf
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Better diffs
*.rs      text diff=rust
*.py      text diff=python
*.md      text diff=markdown

# Binary files: never touch line endings, never diff as text
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.icns    binary
*.pdf     binary
*.onnx    binary
*.parquet binary
*.sqlite  binary

# Lockfiles: collapsed in GitHub diffs
Cargo.lock        linguist-generated=true
package-lock.json linguist-generated=true
